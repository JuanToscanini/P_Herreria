# Variables de entorno del backend - Herrería Ledesma
# Copiar este archivo a .env y completar con valores reales
# Equipo: Juan Toscanini / Roberto Villarrubia

# Base de datos
MONGO_URI=

# Autenticación
JWT_SECRET=

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Mail (SMTP - Gmail u otro proveedor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_EMAIL_TO=

# MercadoPago (Checkout Pro) - usar SIEMPRE credenciales de PRUEBA en desarrollo
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
